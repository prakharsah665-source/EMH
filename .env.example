# Copy this file to .env and replace placeholder values with your own secrets.
# Do not commit .env.

# -----------------------------------------------------------------------------
# Required for live interview E2E tests
# -----------------------------------------------------------------------------
# Fresh primary interview session used by the full-interview evaluation.
INTERVIEW_URL=https://your-environment.example/interview/<session-token>?version=v1

# A distinct, fresh session used by the remaining E2E tests.
EMH_TESTS_URL=https://your-environment.example/interview/<session-token>?version=v1

# -----------------------------------------------------------------------------
# Required for LLM-based evaluation
# -----------------------------------------------------------------------------
# OpenAI-compatible judge endpoint and credentials.
API_KEY=your-judge-api-key
BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=openai/gpt-oss-20b

# Candidate simulator model. NEMOTRON_API_KEY and NEMOTRON_BASE_URL may be
# omitted to reuse API_KEY and BASE_URL above.
NEMOTRON_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_API_KEY =
NEMOTRON_BASE_URL=
# NEMOTRON_API_KEY=your-simulator-api-key
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# -----------------------------------------------------------------------------
# Required for dashboard validation (tests/app_e2e)
# -----------------------------------------------------------------------------
LOGIN_URL=https://your-dashboard.example/
LOGIN_EMAIL=you@example.com
LOGIN_PASSWORD=your-dashboard-password
Dashboard_API_URL=https://your-api.example/dashboard-data

# Optional pre-issued dashboard JWT. The validator signs in with the
# credentials above when this is omitted, expired, or rejected.
# ACCESS_TOKEN=your-dashboard-jwt

# -----------------------------------------------------------------------------
# Optional endpoints and session provisioning
# -----------------------------------------------------------------------------
# EMH_API_URL=https://your-api.example/trackInterview/interview-event
# EMH_PROVISION_API_URL=https://your-api.example/interviews/provision
# EMH_PROVISION_JOB_ID=123
# EMH_TRANSCRIPT_API_URL=https://your-api.example/transcripts

# -----------------------------------------------------------------------------
# Optional local/offline defaults
# -----------------------------------------------------------------------------
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
# EMH_DISABLE_STT_LOCAL=1
# EMH_STT_MODEL=base
# EMH_TRANSCRIPT_CAPTURE=auto
# EMH_TRANSCRIPT_PATH=artifacts/transcripts/interview_transcript.json
# EMH_SIMULATOR_TIMEOUT_S=90

# -----------------------------------------------------------------------------
# Optional dashboard overrides
# -----------------------------------------------------------------------------
# LOGIN_API_URL=https://your-api.example/auth/sign-in
# DASHBOARD_URL=https://your-dashboard.example/dashboard
# DASHBOARD_HEADLESS=1
# DASHBOARD_TIMEOUT_MS=60000
# DASHBOARD_DRIFT_TOLERANCE=0

# -----------------------------------------------------------------------------
# Optional test tuning (defaults are defined in code)
# -----------------------------------------------------------------------------
# EMH_ALLOW_STALE_INTERVIEW=0
# EMH_INTERVIEW_MAX_S=2700
# EMH_MAX_TURNS=0
# EMH_INTERVIEW_TURNS=1,2,3
# EMH_POST_EXIT_GRACE_S=25
# EMH_BOT_RECOVERY_TIMEOUT=120
# EMH_AGENT_JOIN_TIMEOUT=60
# EMH_BOT_FIRST_SPEECH_TIMEOUT=90
# EMH_BOT_RESPONSE_TIMEOUT=60
# EMH_ROOM_DISCONNECT_GRACE=180
# EMH_TEST_MODE=competency
# EMH_SIMULATOR_PERSONA=average
# EMH_SIMULATOR_MAX_QUESTIONS=6
# EMH_TRANSCRIPT_MAX_AGE_SECONDS=7200
# EMH_MIN_CAPTURE_COVERAGE=0.5
# EMH_LIVE_REDTEAM=0
# EMH_REDTEAM_TARGET=https://your-target.example
